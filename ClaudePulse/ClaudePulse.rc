    CONTROL         "Off", IDC_RADIO_DETAIL_OFF, "Static", SS_LEFT | SS_NOTIFY, 250, 18, 48, 14
    CONTROL         "On", IDC_RADIO_DETAIL_ON, "Static", SS_LEFT | SS_NOTIFY, 300, 18, 48, 14
    GROUPBOX        "Usage", IDC_GROUP_MONITOR, 6, 42, 348, 258
    CTEXT           "-", IDC_STATIC_MODEL, 14, 56, 332, 16
    CONTROL         "", IDC_PULSE_METER, "Static", SS_LEFT, 14, 76, 332, 48
    LTEXT           "Input:", IDC_STATIC_INPUT_LABEL, 14, 132, 68, 10
    RTEXT           "0", IDC_STATIC_INPUT, 84, 132, 80, 10
    LTEXT           "Output:", IDC_STATIC_OUTPUT_LABEL, 186, 132, 68, 10
    RTEXT           "0", IDC_STATIC_OUTPUT, 256, 132, 86, 10
    LTEXT           "Cache read:", IDC_STATIC_CACHE_R_LABEL, 14, 146, 68, 10
    RTEXT           "0", IDC_STATIC_CACHE_R, 84, 146, 80, 10
    LTEXT           "Cache write:", IDC_STATIC_CACHE_C_LABEL, 186, 146, 68, 10
    RTEXT           "0", IDC_STATIC_CACHE_C, 256, 146, 86, 10
    LTEXT           "Total:", IDC_STATIC_TOTAL_LABEL, 14, 162, 68, 10
    RTEXT           "0", IDC_STATIC_TOTAL, 84, 162, 80, 10
    LTEXT           "Rate:", IDC_STATIC_RATE_LABEL, 186, 162, 68, 10
