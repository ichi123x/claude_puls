    GROUPBOX        "Size", IDC_GROUP_SIZE, 124, 4, 112, 34
    CONTROL         "Small", IDC_RADIO_SIZE_SMALL, "Static", SS_LEFT | SS_NOTIFY, 132, 18, 48, 14
