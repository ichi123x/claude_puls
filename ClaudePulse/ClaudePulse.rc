    LTEXT           "Weekly (model)", IDC_STATIC_WEEK_MODEL_LABEL, 14, 250, 332, 10
    CONTROL         "", IDC_BAR_WEEK_MODEL, "Static", SS_LEFT, 14, 262, 264, 8
